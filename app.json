{
  "expo": {
    "name": "MyArad",
    "slug": "MyArad",
    "version": "1.2.3",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "myarad",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.myarad.app",
      "icon": "./assets/images/app-icon.png"
    },
    "android": {
      "package": "com.myarad.app",
      "icon": "./assets/images/app-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#885c40",
        "foregroundImage": "./assets/images/app-icon-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "versionCode": 7
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/app-favicon.png"
    },
    "plugins": [
      "./plugins/with-android-cmake",
      "./plugins/with-release-signing",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MyArad uses your location while you explore, to show where you are and find directions.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      "expo-asset",
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "MyArad adaug\u0103 \u00een calendar evenimentele pe care le alegi.",
          "calendarPermission": "MyArad folose\u0219te calendarul ales pentru a ad\u0103uga evenimentele tale."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "457bceff-55bf-4a60-a51b-510f6d494c65"
      }
    }
  }
}
