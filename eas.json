{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "production": {
      "environment": "production"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://experience-directive-manor-rugs.trycloudflare.com"
      }
    },
    "simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    }
  }
}
