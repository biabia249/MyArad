PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
DATABASE_PATH=server/data/myarad.sqlite
WEB_ORIGIN=http://localhost:8081
# Optional extra exact origins, comma-separated. WEB_ORIGIN is always respected.
# In development the server also allows its own private LAN IP on ports 8081/8082.
# For the current host you can explicitly use WEB_ORIGIN=http://172.20.10.8:8081
WEB_ORIGINS=
# Google Cloud > Google Auth Platform > Clients > Web application.
# Register PUBLIC_BASE_URL/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional password reset delivery (Resend, verified sender domain).
RESEND_API_KEY=
EMAIL_FROM=

# Hackathon prototype: any signed-in user may publish events.
# Use google to require Google-verified identities instead.
EVENT_POSTING=signed-in

# Optional: enables server-side discovery of public Facebook/Instagram announcements.
# Get a Brave Search API subscription; never expose this key in EXPO_PUBLIC variables.
BRAVE_SEARCH_API_KEY=
# Preferred alternative: Tavily. If both are configured, Tavily is used.
TAVILY_API_KEY=
